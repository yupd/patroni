#!/bin/bash
# 生成随机硬件码，格式: XXXX-XXXX-XXXX-XXXX
# getMACRDJC.sh 依赖此工具将 hash 转换为虚拟 MAC 地址

MACHINE_ID_FILE=/home/kingbase/userdata/etc/.machine-id

if [ -f "$MACHINE_ID_FILE" ]; then
    cat "$MACHINE_ID_FILE"
    exit 0
fi

# 首次生成
mkdir -p "$(dirname "$MACHINE_ID_FILE")"
if command -v uuidgen &>/dev/null; then
    uuidgen | tr -d '-' | head -c 16
else
    cat /dev/urandom | tr -dc '0-9A-F' | head -c 16
fi | sed 's/\(.\{4\}\)/\1-/g' | sed 's/-$//' | tr 'a-z' 'A-Z' | tee "$MACHINE_ID_FILE"
